#!/bin/bash
# Rebuild idunn and reset the linux-builder VM so it stops trying
# nix-cache.martinache.net as a substituter.
#
# This can't be done as a per-invocation flag (see NIX_BUILD.md /
# machines/hosts/idunn/default.nix comments on the substituter) - the VM's
# own /etc/nix/nix.conf is baked in at build time, so toggling it means
# rebuilding idunn's config and resetting the VM to pick up the new closure.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
MARKER="/tmp/builder-no-cache-marker"

touch "$MARKER"

echo "==> Rebuilding idunn (linux-builder cache substituter disabled)..."
"$SCRIPT_DIR/nix-deploy" local switch --no-cache

echo "==> Resetting linux-builder VM to pick up the new config..."
echo "y" | "$SCRIPT_DIR/nix-deploy" runner-reset
