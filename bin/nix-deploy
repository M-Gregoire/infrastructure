#!/usr/bin/env bash

set -euo pipefail

# Check if running with sudo - this breaks privilege escalation
if [ "${SUDO_USER:-}" != "" ]; then
    echo "❌ Error: Do not run nix-deploy with sudo"
    echo ""
    echo "The script handles privilege escalation internally using Privileges.app and askpass helpers."
    echo "Running with sudo will break the privilege escalation mechanism."
    echo ""
    echo "Run without sudo:"
    echo "  ./bin/nix-deploy local"
    echo ""
    exit 1
fi

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." &>/dev/null && pwd)"
PUBLIC_HOSTS_JSON="$REPO_ROOT/hosts.json"
PRIVATE_CONFIG_PATH="${INFRASTRUCTURE_PRIVATE:-/private/etc/nix/infrastructure-private}"
PRIVATE_HOSTS_JSON="$PRIVATE_CONFIG_PATH/hosts.json"
HOSTS_JSON="$PUBLIC_HOSTS_JSON"
HOSTS_JSON_TMP=""

# Colors for output using tput (more compatible)
if command -v tput >/dev/null 2>&1 && [[ -t 1 ]]; then
    RED=$(tput setaf 1)
    GREEN=$(tput setaf 2)
    YELLOW=$(tput setaf 3)
    BLUE=$(tput setaf 4)
    PURPLE=$(tput setaf 5)
    CYAN=$(tput setaf 6)
    BOLD=$(tput bold)
    NC=$(tput sgr0) # No Color
else
    # Fallback: no colors if tput unavailable or not a terminal
    RED=""
    GREEN=""
    YELLOW=""
    BLUE=""
    PURPLE=""
    CYAN=""
    BOLD=""
    NC=""
fi

# Emoji for better UX
EMOJI_LOCAL="🏠"
EMOJI_REMOTE="🚀"  
EMOJI_BUILD="🔨"
EMOJI_DEPLOY="⚡"
EMOJI_DRY="🧪"
EMOJI_SUCCESS="✅"
EMOJI_ERROR="❌"

print_usage() {
    printf "${CYAN}nix-deploy${NC} - Unified NixOS/nix-darwin deployment tool\n\n"
    printf "${BOLD}${YELLOW}USAGE:${NC}\n"
    printf "    nix-deploy <COMMAND> [OPTIONS] [TARGETS...]\n\n"
    printf "${BOLD}${YELLOW}COMMANDS:${NC}\n"
    printf "    ${GREEN}local${NC} [build|switch]         Build or deploy local configuration\n"
    printf "    ${GREEN}build${NC} <HOST> [HOST...]        Cross-build configuration for target host(s)\n"  
    printf "    ${GREEN}deploy${NC} <HOST> [HOST...]       Deploy configuration to target host(s)\n"
    printf "    ${GREEN}update-private-lock${NC} [--push]   Pin flake.lock to current private-config commit\n"
    printf "    ${GREEN}list${NC}                          List all available hosts and their details\n"
    printf "    ${GREEN}runner-create${NC}                 Start linux-builder VM in foreground (for debugging)\n"
    printf "    ${GREEN}runner-reboot${NC}                 Restart the linux-builder launchd service\n"
    printf "    ${GREEN}runner-reset${NC}                  Delete disk image and restart linux-builder from scratch\n"
    printf "    ${GREEN}help${NC}                          Show this help message\n\n"
    printf "${BOLD}${YELLOW}LOCAL COMMAND:${NC}\n"
    printf "    nix-deploy local                 Deploy local config (switch)\n"
    printf "    nix-deploy local build           Build local config only\n"  
    printf "    nix-deploy local switch          Deploy local config (same as 'nix-deploy local')\n\n"
    printf "${BOLD}${YELLOW}BUILD COMMAND:${NC}\n"
    printf "    nix-deploy build <HOST>          Build config for HOST (cross-build if needed)\n"
    printf "    nix-deploy build <HOST> <HOST2>  Build configs for multiple hosts\n"
    printf "    nix-deploy build all             Build configs for all hosts\n"
    printf "    nix-deploy build hades           Build configs for all hades cluster nodes\n"
    printf "    ${CYAN}Note: Cross-platform builds work best with remote builders${NC}\n\n"
    printf "${BOLD}${YELLOW}DEPLOY COMMAND:${NC}\n"
    printf "    nix-deploy deploy <HOST>         Deploy config to HOST (remote-build by default)\n"
    printf "    nix-deploy deploy <HOST> --local Deploy config to HOST (build locally then deploy)\n"
    printf "    nix-deploy deploy all            Deploy to all hosts\n"  
    printf "    nix-deploy deploy hades          Deploy to all hades cluster nodes\n"
    printf "    nix-deploy deploy local-hosts    Deploy to local development machines\n\n"
    printf "${BOLD}${YELLOW}OPTIONS:${NC}\n"
    printf "    --dry                            Perform dry run (build only, no activation)\n"
    printf "    --local                          Cross-compile locally (for RPi/aarch64 targets)\n"
    printf "    --remote                         Force remote building, skip cross-compile prompt\n"
    printf "    --switch                         Activate immediately (default: boot, requires reboot)\n"
    printf "    --skip-checks                    Skip evaluation checks for faster deployment\n"
    printf "    --no-cache                       Skip remote builder/cache (use only cache.nixos.org)\n"
    printf "    --help, -h                       Show help for specific command\n\n"
    printf "${BOLD}${YELLOW}EXAMPLES:${NC}\n"
    printf "    nix-deploy local                 # Deploy to current machine\n"
    printf "    nix-deploy local build --dry     # Test build current machine config\n"
    printf "    nix-deploy build mimir           # Cross-build mimir config\n"  
    printf "    nix-deploy deploy mimir          # Deploy to mimir (remote build)\n"
    printf "    nix-deploy deploy mimir --local  # Deploy to mimir (local build)\n"
    printf "    nix-deploy deploy hades-1 --local --switch  # Deploy and activate immediately\n"
    printf "    nix-deploy deploy all --dry      # Dry run deploy to all hosts\n"
    printf "    nix-deploy update-private-lock --push  # Push private config and update flake.lock\n"
    printf "    nix-deploy list                  # Show all available hosts\n\n"
    printf "${BOLD}${YELLOW}AUTOMATIC DETECTION:${NC}\n"
    printf "    ${EMOJI_LOCAL} Local deployment automatically uses nix-darwin (macOS) or nixos-rebuild (Linux)\n"
    printf "    ${EMOJI_BUILD} Cross-building detects remote builders (nix-rosetta-builder, etc.) and architecture differences\n"
    printf "    ${EMOJI_REMOTE} Remote deployment uses deploy-rs with intelligent build location selection\n\n"
}

print_error() {
    echo -e "${RED}${EMOJI_ERROR} Error: $1${NC}" >&2
}

print_success() {
    echo -e "${GREEN}${EMOJI_SUCCESS} $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

load_github_token() {
    if [[ -n "${GITHUB_TOKEN:-}" ]]; then
        return
    fi

    echo "🔐 Loading GitHub token from password manager..."

    if [[ -n "${NIX_DEPLOY_GITHUB_TOKEN_COMMAND:-}" ]]; then
        echo "   Using configured token command"
        export GITHUB_TOKEN="$(eval "$NIX_DEPLOY_GITHUB_TOKEN_COMMAND")"
    elif command -v bw >/dev/null 2>&1; then
        echo "   Using Bitwarden"
        export GITHUB_TOKEN="$(bw get password github-nix-token)"
    else
        print_error "No GitHub token source configured. Set GITHUB_TOKEN or NIX_DEPLOY_GITHUB_TOKEN_COMMAND."
        exit 1
    fi
}

# Load and parse hosts.json, optionally overlaying private host metadata.
load_hosts() {
    if [[ ! -f "$PUBLIC_HOSTS_JSON" ]]; then
        print_error "hosts.json not found at $PUBLIC_HOSTS_JSON"
        exit 1
    fi

    if ! command -v jq >/dev/null 2>&1; then
        print_error "jq is required but not installed"
        exit 1
    fi

    if [[ -f "$PRIVATE_HOSTS_JSON" ]]; then
        HOSTS_JSON_TMP="$(mktemp -t nix-deploy-hosts.XXXXXX)"
        trap '[[ -n "${HOSTS_JSON_TMP:-}" ]] && rm -f "$HOSTS_JSON_TMP"' EXIT
        jq -s '.[0] * .[1]' "$PUBLIC_HOSTS_JSON" "$PRIVATE_HOSTS_JSON" > "$HOSTS_JSON_TMP"
        HOSTS_JSON="$HOSTS_JSON_TMP"
    else
        HOSTS_JSON="$PUBLIC_HOSTS_JSON"
    fi
}

get_host_info() {
    local host="$1"
    local field="$2"
    
    jq -r ".\"$host\".\"$field\" // empty" "$HOSTS_JSON"
}

get_host_architecture() {
    local host="$1"
    local system
    system="$(get_host_info "$host" "system")"
    
    # Extract architecture from system (e.g., "x86_64-darwin" -> "x86_64")
    echo "${system%%-*}"
}

list_hosts() {
    echo -e "${CYAN}Available hosts:${NC}"
    echo
    
    jq -r 'to_entries[] | "\(.key)|\(.value.system)|\(.value.profile)|\(.value.network)|\(.value.cluster // "none")"' "$HOSTS_JSON" | \
    while IFS='|' read -r name system profile network cluster; do
        if [[ "$cluster" != "none" ]]; then
            cluster_info=" (${cluster})"
        else
            cluster_info=""
        fi
        
        printf "  %-12s ${GREEN}%-14s${NC} %-8s %-8s${PURPLE}%s${NC}\n" \
            "$name" "$system" "$profile" "$network" "$cluster_info"
    done
    echo
}

get_current_hostname() {
    hostname
}

get_private_flake_options() {
    if [[ -d "$PRIVATE_CONFIG_PATH/.git" ]]; then
        printf '%s\0' --override-input private-config "git+file://$PRIVATE_CONFIG_PATH"
    fi
}

get_current_system() {
    case "$(uname -s)" in
        Darwin)
            case "$(uname -m)" in
                x86_64) echo "x86_64-darwin" ;;
                arm64|aarch64) echo "aarch64-darwin" ;;
                *) echo "unknown-darwin" ;;
            esac
            ;;
        Linux) 
            case "$(uname -m)" in
                x86_64) echo "x86_64-linux" ;;
                aarch64|arm64) echo "aarch64-linux" ;;
                *) echo "unknown-linux" ;;
            esac
            ;;
        *) echo "unknown" ;;
    esac
}

is_local_host() {
    local target_host="$1"
    local current_hostname
    current_hostname="$(get_current_hostname)"
    local target_hostname
    target_hostname="$(get_host_info "$target_host" "hostname")"

    # Check direct hostname match.
    if [[ -n "$target_hostname" ]] && { [[ "$current_hostname" == "$target_hostname"* ]] || [[ "$current_hostname" == *"$target_hostname"* ]]; }; then
        return 0
    fi

    # Check optional aliases from hosts.json/private hosts.json.
    while IFS= read -r alias; do
        if [[ -n "$alias" ]] && [[ "$current_hostname" == *"$alias"* ]]; then
            return 0
        fi
    done < <(jq -r ".\"$target_host\".localHostAliases[]? // empty" "$HOSTS_JSON")

    return 1
}

needs_cross_build() {
    local target_host="$1"
    local current_system target_system
    
    current_system="$(get_current_system)"
    target_system="$(get_host_info "$target_host" "system")"
    
    [[ "$current_system" != "$target_system" ]]
}

handle_dry_flag() {
    local -n _args=$1
    local is_deploy_rs="$2"
    local -a filtered_args=()
    local dry_run=false
    
    for arg in "${_args[@]}"; do
        if [[ "$arg" == "--dry" ]]; then
            dry_run=true
            if [[ "$is_deploy_rs" == "true" ]]; then
                filtered_args+=("--dry-activate")
            else
                filtered_args+=("--dry")
            fi
        else
            filtered_args+=("$arg")
        fi
    done
    
    _args=("${filtered_args[@]}")
    [[ "$dry_run" == "true" ]]
}

get_flake_uri() {
    local host="$1"
    local use_submodules
    use_submodules="$(jq -r ".\"$host\".requiresSubmodules // false" "$HOSTS_JSON")"

    if [[ "$use_submodules" == "true" ]]; then
        echo ".?submodules=1#$host"
    else
        echo ".#$host"
    fi
}



is_clamshell_mode() {
    # Check if built-in display is active (macOS only)
    if [[ "$(uname -s)" != "Darwin" ]]; then
        return 1
    fi

    # Check if built-in display is detected using system_profiler
    if system_profiler SPDisplaysDataType 2>/dev/null | grep -qi "built-in"; then
        return 1  # Not clamshell (built-in display active)
    else
        return 0  # Clamshell mode (no built-in display detected)
    fi
}

cmd_local() {
    local action="${1:-switch}"
    shift || true
    local -a extra_args=("$@")

    local current_hostname
    current_hostname="$(get_current_hostname)"
    local use_askpass=false

    if [[ -n "${NIX_DEPLOY_PRIVILEGE_COMMAND:-}" ]]; then
        print_info "Requesting admin privileges..."
        if ! eval "$NIX_DEPLOY_PRIVILEGE_COMMAND"; then
            print_error "Failed to obtain admin privileges"
            exit 1
        fi

        # Use askpass in clamshell mode OR non-interactive mode.
        if is_clamshell_mode; then
            print_info "Clamshell mode - using password prompt"
            export SUDO_ASKPASS="$SCRIPT_DIR/sudo-askpass-pinentry"
            use_askpass=true
        elif [[ ! -t 0 ]] || [[ ! -t 1 ]]; then
            print_info "Non-interactive mode - using password prompt"
            export SUDO_ASKPASS="$SCRIPT_DIR/sudo-askpass-pinentry"
            use_askpass=true
        fi
    fi

    # Use sudo -A only in clamshell mode
    local sudo_cmd="sudo"
    if [[ "$use_askpass" == "true" ]]; then
        sudo_cmd="sudo -A"
    fi

    local current_system
    current_system="$(get_current_system)"
    local -a flake_options=()
    readarray -d '' -t flake_options < <(get_private_flake_options)
    local is_dry_run=false

    if handle_dry_flag extra_args "false"; then
        is_dry_run=true
    fi
    
    # Determine current host config name by matching hostname
    local current_hostname host_config=""
    current_hostname="$(get_current_hostname)"
    
    # Find matching host in hosts.json
    while IFS= read -r host; do
        if is_local_host "$host"; then
            host_config="$host"
            break
        fi
    done < <(jq -r 'keys[]' "$HOSTS_JSON")
    
    if [[ -z "$host_config" ]]; then
        print_error "No host configuration found for current hostname: $current_hostname"
        exit 1
    fi
    
    local flake_uri
    flake_uri="$(get_flake_uri "$host_config")"

    local host_network
    host_network="$(get_host_info "$host_config" "network")"
    local no_cache=false
    local -a filtered_args=()
    for arg in "${extra_args[@]}"; do
        if [[ "$arg" == "--no-cache" ]]; then
            no_cache=true
        else
            filtered_args+=("$arg")
        fi
    done
    extra_args=("${filtered_args[@]}")
    local -a cache_options=()
    if [[ "$no_cache" == "true" ]] || [[ "$host_network" != "home" ]]; then
        # Skip remote builder/cache — use only cache.nixos.org. This must be
        # a literal --option, not a NIX_CONFIG env var: the darwin/nixos
        # branches below exec through plain `sudo` (no -E), which strips
        # almost all environment variables by default, so NIX_CONFIG alone
        # never actually reached the root-owned rebuild process.
        cache_options=(--option substituters "https://cache.nixos.org/" --option extra-substituters "")
    fi

    case "$current_system" in
        *darwin*)
            local cmd="darwin-rebuild"
            # Don't override builders on darwin — the linux builder VM is local and needed
            local nix_options=(
                --option max-jobs auto
                "${cache_options[@]}"
            )
            if [[ "$action" == "switch" ]]; then
                if [[ "$is_dry_run" == "true" ]]; then
                    print_info "${EMOJI_LOCAL} Local deployment (dry run): $cmd build --flake $flake_uri"
                    exec $sudo_cmd "$cmd" build --flake "$flake_uri" "${flake_options[@]}" "${nix_options[@]}" "${extra_args[@]}"
                else
                    print_info "${EMOJI_LOCAL} Local deployment: $cmd switch --flake $flake_uri"
                    exec $sudo_cmd "$cmd" switch --flake "$flake_uri" "${flake_options[@]}" "${nix_options[@]}" "${extra_args[@]}"
                fi
            else
                print_info "${EMOJI_BUILD} Local build: $cmd build --flake $flake_uri"
                exec sudo -A "$cmd" build --flake "$flake_uri" "${flake_options[@]}" "${nix_options[@]}" "${extra_args[@]}"
            fi
            ;;
        *linux*)
            local cmd="nixos-rebuild"
            # Force local building by overriding builders configuration
            local nix_options=(
                --option builders ""
                --option max-jobs auto
                "${cache_options[@]}"
            )
            if [[ "$action" == "switch" ]]; then
                if [[ "$is_dry_run" == "true" ]]; then
                    print_info "${EMOJI_LOCAL} Local deployment (dry run): $cmd build --flake $flake_uri"
                    exec $sudo_cmd "$cmd" build --flake "$flake_uri" "${flake_options[@]}" "${nix_options[@]}" "${extra_args[@]}"
                else
                    print_info "${EMOJI_LOCAL} Local deployment: $cmd switch --flake $flake_uri"
                    exec $sudo_cmd "$cmd" switch --flake "$flake_uri" "${flake_options[@]}" "${nix_options[@]}" "${extra_args[@]}"
                fi
            else
                print_info "${EMOJI_BUILD} Local build: $cmd build --flake $flake_uri"
                exec sudo -A "$cmd" build --flake "$flake_uri" "${flake_options[@]}" "${nix_options[@]}" "${extra_args[@]}"
            fi
            ;;
        *)
            print_error "Unsupported system: $current_system"
            exit 1
            ;;
    esac
}

expand_host_groups() {
    local -a hosts=()
    local -a expanded=()
    
    for arg in "$@"; do
        case "$arg" in
            all)
                while IFS= read -r host; do
                    expanded+=("$host")
                done < <(jq -r 'keys[]' "$HOSTS_JSON")
                ;;
            hades)
                while IFS= read -r host; do
                    if [[ "$(get_host_info "$host" "cluster")" == "hades" ]]; then
                        expanded+=("$host")
                    fi
                done < <(jq -r 'keys[]' "$HOSTS_JSON")
                ;;
            local-hosts)
                for host in mimir idunn; do
                    if jq -e ".\"$host\"" "$HOSTS_JSON" >/dev/null 2>&1; then
                        expanded+=("$host")
                    fi
                done
                ;;
            *)
                if jq -e ".\"$arg\"" "$HOSTS_JSON" >/dev/null 2>&1; then
                    expanded+=("$arg")
                else
                    print_error "Unknown host or group: $arg"
                    exit 1
                fi
                ;;
        esac
    done
    
    printf '%s\n' "${expanded[@]}"
}

cmd_build() {
    local -a targets=()
    local -a extra_args=()
    local dry_run=false
    local no_cache=false

    # Load GitHub token for API access
    load_github_token

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                print_usage
                exit 0
                ;;
            --dry)
                dry_run=true
                extra_args+=("--dry-run")
                ;;
            --no-cache)
                no_cache=true
                ;;
            --*|-*)
                extra_args+=("$1")
                ;;
            *)
                targets+=("$1")
                ;;
        esac
        shift
    done
    
    if [[ ${#targets[@]} -eq 0 ]]; then
        print_error "No build targets specified"
        print_info "Usage: nix-deploy build <HOST> [HOST...]"
        exit 1
    fi
    
    local -a expanded_hosts
    readarray -t expanded_hosts < <(expand_host_groups "${targets[@]}")
    local -a flake_options=()
    readarray -d '' -t flake_options < <(get_private_flake_options)
    if [[ "$no_cache" == "true" ]]; then
        export NIX_CONFIG="substituters = https://cache.nixos.org/"
    fi

    for host in "${expanded_hosts[@]}"; do
        local target_system
        target_system="$(get_host_info "$host" "system")"

        # Determine the correct attribute path based on system type
        local build_target
        if [[ "$target_system" == *"darwin"* ]]; then
            build_target=".#darwinConfigurations.$host.system"
        else
            build_target=".#nixosConfigurations.$host.config.system.build.toplevel"
        fi

        if needs_cross_build "$host"; then
            print_info "${EMOJI_BUILD} Cross-building $host ($target_system)..."
            nix build "$build_target" "${flake_options[@]}" --option access-tokens "github.com/M-Gregoire=$GITHUB_TOKEN" "${extra_args[@]}"
        else
            # Building for same platform - force local building
            print_info "${EMOJI_BUILD} Building $host (local)"
            nix build "$build_target" "${flake_options[@]}" --option builders "" --option max-jobs auto --option access-tokens "github.com/M-Gregoire=$GITHUB_TOKEN" "${extra_args[@]}"
        fi
    done
    
    print_success "Build completed for: ${expanded_hosts[*]}"
}

cmd_update_private_lock() {
    local push_private=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --push)
                push_private=true
                ;;
            --help|-h)
                printf "${CYAN}nix-deploy update-private-lock${NC} - Pin flake.lock to current private-config commit\n\n"
                printf "Usage: nix-deploy update-private-lock [--push]\n\n"
                printf "Updates the public flake.lock private-config input to the current commit in:\n"
                printf "  %s\n\n" "$PRIVATE_CONFIG_PATH"
                printf "Options:\n"
                printf "  --push   Push the private repo before updating flake.lock\n"
                return 0
                ;;
            *)
                print_error "Unknown update-private-lock option: $1"
                exit 1
                ;;
        esac
        shift
    done

    if [[ ! -d "$PRIVATE_CONFIG_PATH/.git" ]]; then
        print_error "private-config git repo not found at $PRIVATE_CONFIG_PATH"
        exit 1
    fi

    if [[ -n "$(git -C "$PRIVATE_CONFIG_PATH" status --porcelain)" ]]; then
        print_error "private-config has uncommitted changes. Commit or stash them before updating flake.lock."
        git -C "$PRIVATE_CONFIG_PATH" status --short
        exit 1
    fi

    if [[ "$push_private" == "true" ]]; then
        print_info "Pushing private-config..."
        git -C "$PRIVATE_CONFIG_PATH" push
    fi

    local private_rev private_ref ahead_count
    private_rev="$(git -C "$PRIVATE_CONFIG_PATH" rev-parse HEAD)"
    private_ref="git+file://$PRIVATE_CONFIG_PATH?rev=$private_rev"

    if git -C "$PRIVATE_CONFIG_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        ahead_count="$(git -C "$PRIVATE_CONFIG_PATH" rev-list --count '@{u}..HEAD')"
        if [[ "$ahead_count" != "0" ]]; then
            print_warning "private-config is $ahead_count commit(s) ahead of upstream. Other machines must fetch/pull it before this lock works."
            print_warning "Run with --push to push private-config first."
        fi
    fi

    print_info "Updating flake.lock private-config to $private_rev"
    nix flake update --override-input private-config "$private_ref" private-config
    git add flake.lock
    print_success "Updated and staged flake.lock"
}

cmd_deploy() {
    local -a targets=()
    local -a extra_args=()
    local force_local_build=false
    local force_remote_build=false
    local activation_action="boot"
    local no_cache=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                print_usage
                exit 0
                ;;
            --local)
                force_local_build=true
                ;;
            --remote)
                force_remote_build=true
                ;;
            --switch)
                activation_action="switch"
                ;;
            --no-cache)
                no_cache=true
                ;;
            --dry|--skip-checks)
                extra_args+=("$1")
                ;;
            -*)
                extra_args+=("$1")
                ;;
            *)
                targets+=("$1")
                ;;
        esac
        shift
    done
    
    if [[ ${#targets[@]} -eq 0 ]]; then
        print_error "No deployment targets specified"
        print_info "Usage: nix-deploy deploy <HOST> [HOST...] [OPTIONS]"
        exit 1
    fi
    
    local -a expanded_hosts
    readarray -t expanded_hosts < <(expand_host_groups "${targets[@]}")
    
    local is_dry_run=false
    if handle_dry_flag extra_args "true"; then
        is_dry_run=true
    fi
    
    # Add --skip-checks if not present
    local has_skip_checks=false
    for arg in "${extra_args[@]}"; do
        if [[ "$arg" == "--skip-checks" ]]; then
            has_skip_checks=true
            break
        fi
    done
    
    if [[ "$has_skip_checks" == "false" ]]; then
        extra_args+=("--skip-checks")
    fi
    
    # Handle single host local deployment
    if [[ ${#expanded_hosts[@]} -eq 1 ]] && is_local_host "${expanded_hosts[0]}"; then
        print_info "${EMOJI_LOCAL} Detected local deployment for ${expanded_hosts[0]}"
        local -a local_args=("${extra_args[@]}")
        if [[ "$no_cache" == "true" ]]; then
            local_args+=("--no-cache")
        fi
        if [[ "$is_dry_run" == "true" ]]; then
            cmd_local "build" "${local_args[@]}"
        else
            cmd_local "switch" "${local_args[@]}"
        fi
        return
    fi
    
    # Check if any target needs cross-building (different system than local)
    local current_system
    current_system="$(get_current_system)"
    local has_cross_targets=false

    if [[ "$force_remote_build" == "false" ]]; then
        for host in "${expanded_hosts[@]}"; do
            if needs_cross_build "$host"; then
                has_cross_targets=true
                break
            fi
        done
    fi

    if [[ "$has_cross_targets" == "true" ]] && [[ "$force_local_build" == "false" ]]; then
        print_warning "Target(s) require cross-building (different architecture)."
        print_warning "Remote building may be slow or fail due to network issues."
        echo -en "${YELLOW}Cross-compile locally instead? [Y/n] ${NC}"
        read -r answer
        if [[ "$answer" != "n" ]] && [[ "$answer" != "N" ]]; then
            force_local_build=true
        fi
    fi
    
    # Remote deployment via deploy-rs
    local -a flake_targets=()
    local -a deploy_extra_args=()
    for host in "${expanded_hosts[@]}"; do
        local flake_uri
        flake_uri="$(get_flake_uri "$host")"
        flake_targets+=("$flake_uri")
    done
    
    # If cross-compiling locally, build closures, copy to target, and activate
    if [[ "$force_local_build" == "true" ]]; then
        load_github_token
        local -a flake_options=()
        readarray -d '' -t flake_options < <(get_private_flake_options)
        if [[ "$no_cache" == "true" ]]; then
            export NIX_CONFIG="substituters = https://cache.nixos.org/"
            # NIX_CONFIG only replaces the base `substituters` list — it can't
            # clear `extra-substituters` contributed by the flake's own
            # nixConfig (once accepted, nix applies it automatically on every
            # invocation, additively, regardless of NIX_CONFIG). An explicit
            # --option flag on the build command itself is the only thing
            # with high enough priority to actually suppress it.
            flake_options+=(--option extra-substituters "")
        fi
        for host in "${expanded_hosts[@]}"; do
            
            local target_hostname
            target_hostname="$(get_host_info "$host" "deployHostname")"
            target_hostname="${target_hostname:-$(get_host_info "$host" "hostname")}"
            local ssh_port
            ssh_port="$(get_host_info "$host" "sshPort")"
            ssh_port="${ssh_port:-22}"
            local ssh_target="root@${target_hostname}"
            local ssh_opts="-p ${ssh_port}"
            
            local build_target=".#nixosConfigurations.${host}.config.system.build.toplevel"
            print_info "${EMOJI_BUILD} Cross-compiling $host locally..."
            local out_path
            out_path=$(nix build "$build_target" "${flake_options[@]}" --print-out-paths --no-link \
                --option access-tokens "github.com/M-Gregoire=$GITHUB_TOKEN") || {
                print_error "Local build failed for $host"
                exit 1
            }
            
            print_info "${EMOJI_DEPLOY} Copying closure to $host..."
            NIX_SSHOPTS="-p ${ssh_port}" nix copy --no-check-sigs --to "ssh-ng://${ssh_target}" "$out_path" || {
                print_error "Failed to copy closure to $host"
                exit 1
            }
            
            if [[ "$is_dry_run" == "true" ]]; then
                print_info "${EMOJI_DRY} Dry run — skipping activation for $host"
            else
                print_info "⚡ Activating $host ($activation_action)..."
                ssh $ssh_opts "$ssh_target" \
                    "nix-env -p /nix/var/nix/profiles/system --set $out_path && $out_path/bin/switch-to-configuration $activation_action" || {
                    print_error "Activation failed for $host"
                    exit 1
                }
                if [[ "$activation_action" == "boot" ]]; then
                    print_success "Deployed $host (reboot to activate)"
                else
                    print_success "Deployed $host (activated)"
                fi
            fi
        done
        
        return
    fi
    
    print_info "${EMOJI_REMOTE} Remote deployment to: ${expanded_hosts[*]}"
    
    if [[ "$is_dry_run" == "true" ]]; then
        print_info "${EMOJI_DRY} Dry run deployment"
    fi
    
    exec deploy "${flake_targets[@]}" "${extra_args[@]}"
}

# --- Linux builder (runner) commands ---

BUILDER_SERVICE="system/org.nixos.linux-builder"

get_create_builder_path() {
    local start_script
    start_script=$(sudo launchctl list org.nixos.linux-builder 2>/dev/null | \
        sed -n 's|.*exec \(/nix/store/[^"]*-linux-builder-start\).*|\1|p')

    if [[ -z "$start_script" || ! -f "$start_script" ]]; then
        print_error "Could not find linux-builder-start script from launchd"
        exit 1
    fi

    local create_builder
    create_builder=$(grep -o '/nix/store/[^ ]*create-builder' "$start_script" | head -1)

    if [[ -z "$create_builder" || ! -x "$create_builder" ]]; then
        print_error "Could not find create-builder binary in $start_script"
        exit 1
    fi

    echo "$create_builder"
}

kill_stale_builder() {
    # Kill any leftover vzvm/qemu processes and anything holding port 31022.
    # Must be called AFTER launchctl bootout to prevent KeepAlive respawns.
    local pids
    pids=$(pgrep -x 'vzvm|qemu-system-aarch64' 2>/dev/null || true)
    if [[ -n "$pids" ]]; then
        print_warning "Killing stale VM process(es): $pids"
        echo "$pids" | xargs sudo kill -9 2>/dev/null || true
        sleep 2
    fi
    # Also kill anything else holding the port (wrapper scripts etc.)
    pids=$(sudo lsof -ti :31022 2>/dev/null || true)
    if [[ -n "$pids" ]]; then
        print_warning "Killing process(es) on port 31022: $pids"
        echo "$pids" | xargs sudo kill -9 2>/dev/null || true
        sleep 2
    fi
    # Kill the entire process tree rooted at linux-builder-start
    pids=$(pgrep -f 'linux-builder-start|create-builder|run-nixos-vm|run-builder' 2>/dev/null || true)
    if [[ -n "$pids" ]]; then
        echo "$pids" | xargs sudo kill -9 2>/dev/null || true
        sleep 1
    fi
}

cmd_runner_create() {
    print_info "Starting linux-builder in foreground..."
    kill_stale_builder
    local create_builder
    create_builder="$(get_create_builder_path)"
    print_info "Running: $create_builder"
    sudo "$create_builder"
}

cmd_runner_reboot() {
    print_info "Restarting linux-builder service..."
    kill_stale_builder
    sudo launchctl kickstart -k "$BUILDER_SERVICE"
    print_info "Waiting for builder VM to start (port 31022)..."
    local elapsed=0
    while (( elapsed < 90 )); do
        if sudo lsof -i :31022 >/dev/null 2>&1; then
            print_success "Linux builder VM is listening on port 31022"
            print_info "Waiting for SSH to become ready..."
            local ssh_elapsed=0
            while (( ssh_elapsed < 60 )); do
                if sudo ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o BatchMode=yes \
                       -p 31022 -i /etc/nix/builder_ed25519 builder@localhost true 2>/dev/null; then
                    print_success "Linux builder SSH is ready"
                    return 0
                fi
                sleep 5
                ssh_elapsed=$((ssh_elapsed + 5))
            done
            print_warning "VM is listening but SSH not responding after 60s — guest may still be booting"
            return 1
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
    print_warning "Builder did not start listening within 90s — check 'sudo launchctl list org.nixos.linux-builder'"
    return 1
}

cmd_runner_reset() {
    # The store image (erofs) contains the NixOS closure for the guest VM.
    # After darwin-rebuild or nix upgrades, it can get out of sync with the
    # kernel/initrd cmdline, causing initrd-find-nixos-closure to fail and
    # the VM to drop into emergency mode. Deleting both the store image and
    # the qcow2 data disk forces a full rebuild from the current closure.
    local builder_dir="/private/var/lib/linux-builder"
    print_warning "This will delete the builder disk and store images, then recreate from scratch."

    echo -en "${YELLOW}Proceed? [y/N] ${NC}"
    read -r confirm
    if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
        print_info "Aborted"
        return
    fi

    # Stop the launchd service first to prevent KeepAlive respawns
    print_info "Stopping linux-builder service..."
    sudo launchctl bootout "$BUILDER_SERVICE" 2>/dev/null || true
    sleep 1
    kill_stale_builder

    if [[ -f "$builder_dir/nixos.qcow2" ]]; then
        print_info "Deleting data disk: $builder_dir/nixos.qcow2"
        sudo rm -f "$builder_dir/nixos.qcow2"
    fi

    # Delete store images — they get rebuilt from the current nix closure on next boot.
    # This is the key fix: a stale store image causes initrd-find-nixos-closure to fail.
    local store_images
    store_images=$(ls "$builder_dir"/store-*.img 2>/dev/null || true)
    if [[ -n "$store_images" ]]; then
        print_info "Deleting store image(s) to force rebuild from current closure..."
        sudo rm -f "$builder_dir"/store-*.img
    fi

    print_info "Restarting linux-builder service (store image rebuild may take a minute)..."
    sudo launchctl bootstrap system /Library/LaunchDaemons/org.nixos.linux-builder.plist 2>/dev/null || \
        sudo launchctl kickstart "$BUILDER_SERVICE" 2>/dev/null || {
        print_warning "Could not restart service — you may need to run 'darwin-rebuild switch' first"
        return 1
    }

    local elapsed=0
    while (( elapsed < 180 )); do
        if sudo lsof -i :31022 >/dev/null 2>&1; then
            print_success "Linux builder VM is listening on port 31022"
            print_info "Waiting for SSH to become ready..."
            local ssh_elapsed=0
            while (( ssh_elapsed < 90 )); do
                if sudo ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o BatchMode=yes \
                       -p 31022 -i /etc/nix/builder_ed25519 builder@localhost true 2>/dev/null; then
                    # A full reset regenerates the VM's host key. Remote builds
                    # connect via the 'linux-builder' ssh_config alias (real
                    # StrictHostKeyChecking, run as root by the nix-daemon),
                    # which is a separate trust store from the probe above —
                    # without this, the first build after a reset fails with
                    # "failed to start SSH connection to 'linux-builder'"
                    # even though the VM is fully up.
                    print_info "Trusting new builder host key for remote builds..."
                    sudo ssh -F /etc/ssh/ssh_config -o StrictHostKeyChecking=accept-new \
                        -o BatchMode=yes linux-builder true 2>/dev/null || \
                        print_warning "Could not pre-trust the builder host key — the first remote build may need one manual 'sudo ssh linux-builder' to accept it"
                    print_success "Linux builder reset complete — SSH is ready"
                    return 0
                fi
                sleep 5
                ssh_elapsed=$((ssh_elapsed + 5))
            done
            print_warning "VM is listening but SSH not responding after 90s — try 'nix-deploy runner-create' to debug"
            return 1
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
    print_warning "Builder did not start within 180s — check: log show --predicate 'process == \"vzvm\"' --last 5m"
    return 1
}

# Main command dispatcher
main() {
    cd "$REPO_ROOT"
    load_hosts
    
    if [[ $# -eq 0 ]]; then
        print_usage
        exit 1
    fi
    
    local command="$1"
    shift
    
    case "$command" in
        local)
            cmd_local "$@"
            ;;
        build)
            cmd_build "$@"
            ;;
        deploy)
            cmd_deploy "$@"
            ;;
        update-private-lock)
            cmd_update_private_lock "$@"
            ;;
        list)
            list_hosts
            ;;
        runner-create)
            cmd_runner_create
            ;;
        runner-reboot)
            cmd_runner_reboot
            ;;
        runner-reset)
            cmd_runner_reset
            ;;
        help|--help|-h)
            print_usage
            ;;
        *)
            print_error "Unknown command: $command"
            print_info "Run 'nix-deploy help' for usage information"
            exit 1
            ;;
    esac
}

main "$@"
